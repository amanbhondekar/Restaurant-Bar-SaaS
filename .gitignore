# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production build outputs
dist/
build/

# Local environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE & OS temporary files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# IDE subagent / brain logs
.system_generated/
scratch/
.claude/

# Local hub server data (keep seed/template, ignore local runtime state)
hub_server/data/tickets_runtime.json
hub_server/data/crash_log.json
hub_server/data/menu_cache.json
hub_server/data/tables_cache.json
hub_server/data/invoices/

# Rolling safety backups the hub writes before every menu/table edit
hub_server/data/backups/

# Temp files the hub writes while saving a catalog (renamed away on success)
hub_server/data/*.tmp
# Newest menu/table revision the cloud is known to hold
hub_server/data/catalog_sync.json

# A queue file that would not parse, kept aside by loadQueue so the unsent orders and bills
# in it can be recovered by hand instead of being overwritten.
hub_server/data/sync_queue.corrupt-*.json

# Waiter records: names plus scrypt PIN hashes, seeded on first boot. Local to each hub.
hub_server/data/waiters.json
