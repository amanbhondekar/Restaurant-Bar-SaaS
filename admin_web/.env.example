# The admin console page's build settings. All three are PUBLIC: they end up in the page, which anyone who can reach it can read.
# Put real values in the host's environment (or a local, untracked .env), never a secret. The build refuses a service key in any of them.

# Where the admin API (admin_api/) is. https; http only for localhost.
VITE_ADMIN_API_URL=https://admin-api.example.com

# The Supabase project's address and its PUBLIC (anon) key. Never the service key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
